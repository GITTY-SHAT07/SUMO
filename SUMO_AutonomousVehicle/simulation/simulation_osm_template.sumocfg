<?xml version="1.0" encoding="UTF-8"?>
<!-- Copy this file for a new OSM-derived network and adjust net-file/routes. -->
<configuration>
    <input>
        <net-file value="../map.net.xml" />
        <route-files value="../routes/empty.rou.xml" />
    </input>
    <time>
        <begin value="0" />
        <end value="300" />
        <step-length value="0.1" />
    </time>
    <report>
        <no-step-log value="true" />
        <verbose value="false" />
    </report>
</configuration>
