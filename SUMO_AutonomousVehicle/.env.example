# Example: bundled OSM network with preconfigured ego route
SUMO_SCENARIO=large
SUMO_PLANNER=risk
SUMO_BINARY=/path/to/sumo
SUMO_CONFIG_FILE=simulation/simulation_large.sumocfg
SUMO_NETWORK_FILE=map.net.xml
SUMO_GOAL_JUNCTION=2227588809
SUMO_DEBUG_DIAGNOSTICS=0

# For a configurable origin, use the spawn config and set an edge ID:
# SUMO_CONFIG_FILE=simulation/simulation_large_spawn.sumocfg
# SUMO_START_EDGE=-1513939047
# SUMO_GOAL_JUNCTION=2227588809
# SUMO_VEHICLE_CLASS=passenger

# Optional background traffic config:
# SUMO_CONFIG_FILE=simulation/simulation_large_traffic_spawn.sumocfg
